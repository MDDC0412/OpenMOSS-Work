# ============================================================
#  OpenMOSS-Work .gitignore
#  只提交源代码；环境、权重、缓存、依赖、构建产物一律排除
#  注意：运行时目录一律加前导斜杠，只匹配仓库根，
#        否则会误伤 src/app/works/、src/app/api/uploads/ 这类源码目录
# ============================================================

# ---------- Python 虚拟环境 ----------
/env/
/venv/
/.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 模型权重与缓存（体积大，按 README 自行下载） ----------
/models/
/hf-cache/
*.safetensors
*.pth
*.pt
*.bin
*.onnx
*.ckpt
*.gguf

# ---------- Node / Next.js ----------
node_modules/
.next/
/out/
dist/
*.tsbuildinfo
next-env.d.ts
.npm/
.pnpm-store/

# ---------- 密钥与环境变量 ----------
.env
.env.*
!.env.example
env.local
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# ---------- 运行时数据 ----------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/data-dir.json

# ---------- 日志与临时文件 ----------
*.log
/logs/
*.tmp
*.temp
*.bak
*.orig
*.swp
*~

# ---------- 编辑器与系统 ----------
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# ---------- 生成产物 ----------
/outputs/
/output/
/_works/
/_uploads/
*_x4.png
