# ============================================================
#  OpenMOSS-Work 环境变量模板
#  复制为本地环境变量文件后按需修改；真实配置不进仓库。
#  本文件只含占位符，不含任何真实密钥。
#
#  注意：当前启动脚本（.cmd）直接读取系统环境变量，并不自动加载本文件。
#    1) 想用文件管理 -> 在 PowerShell 里载入后再启动
#    2) 想少折腾     -> 直接改 webui\run_moss_api.cmd 里的 set 行
# ============================================================

# ---------- 路径（默认全部基于仓库根目录，通常无需设置） ----------
# MOSS_HOME=D:\OpenMOSS-Work
# MOSS_PYTHON=%MOSS_HOME%\env\python.exe
# MOSS_UPSCALE_DIR=%MOSS_HOME%\models\upscale

# ---------- 服务 ----------
MOSS_PORT=8188
MOSS_MAX_EDGE=960
MOSS_MIN_GEN_EDGE=512

# ---------- 鉴权 ----------
# 留空 = 不校验。对外暴露端口时务必设置。
MOSS_API_KEY=

# ---------- 生图 ----------
# 不加载模型、返回占位图，用于验证链路
MOSS_MOCK=

# ---------- 超分 ----------
MOSS_UPSCALE=1
MOSS_UPSCALE_TARGET=3840

# ---------- LoRA（可选，留空则该模型变体不出现） ----------
# 4 步加速：明显变快，但小字会糊
MOSS_TURBO_LORA=
# 额外风格 LoRA
MOSS_NSFW_LORA=

# ---------- DiffSynth / HuggingFace ----------
# 由 server.py 自动推导，一般不用手填
# DIFFSYNTH_MODEL_BASE_PATH=%MOSS_HOME%\models
# DIFFSYNTH_SKIP_DOWNLOAD=True
# HF_HOME=%MOSS_HOME%\hf-cache
# HF_HUB_ENABLE_HF_TRANSFER=0

# ---------- 量化包相对路径 ----------
# MOSS_DIT_PACKAGE=models/MOSS-Image-SFT/dit_4.5bit.safetensors
# MOSS_TE_PACKAGE=models/text_encoder_4.5bit.safetensors
